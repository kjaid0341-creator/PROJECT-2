# Provide your OpenAI API Key to enable real AI-generated responses:
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Choose OpenAI model (defaults to gpt-4o-mini if not specified)
OPENAI_MODEL=gpt-4o-mini

